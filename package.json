{
  "name": "cursus",
  "version": "0.1.0",
  "private": true,
  "description": "Cursus — plateforme de formation en ligne",
  "scripts": {
    "dev": "node scripts/avec-memoire.mjs next dev",
    "build": "node scripts/avec-memoire.mjs next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "node scripts/avec-memoire.mjs tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrer.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reinitialiser.ts && npm run db:migrate && npm run db:seed",
    "db:studio": "drizzle-kit studio",
    "relances": "tsx scripts/relances.ts",
    "db:generate": "drizzle-kit generate",
    "setup": "npm run db:migrate && npm run db:seed",
    "capsules": "tsx scripts/capsules/generer.ts",
    "captures": "node scripts/captures.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^1.24.0",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "postgres": "3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
