# --- Base de données (PostgreSQL) -------------------------------------------
# Docker Compose local (voir docker-compose.yml) :
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cursus"
# Ou une base Neon gratuite : collez simplement sa chaîne de connexion.
# DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Base dédiée aux tests d'intégration (vidée à chaque lancement !)
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/cursus_test"

# --- Authentification --------------------------------------------------------
# Générer avec : openssl rand -base64 32
AUTH_SECRET="remplacer-par-une-chaine-aleatoire-de-32-octets"
AUTH_URL="http://localhost:3000"
# Facultatif : connexion Google (laisser vide pour la désactiver)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# URL publique de la plateforme — utilisée dans les QR codes des certificats
APP_URL="http://localhost:3000"
# Fuseau horaire d'affichage des dates sur les pages publiques de vérification
APP_TIMEZONE="UTC"

# --- E-mails (Resend) --------------------------------------------------------
# Sans clé, les e-mails s'affichent dans la console du serveur (pratique en dev).
RESEND_API_KEY=""
EMAIL_FROM="Cursus <noreply@exemple.test>"

# --- Stockage des fichiers ---------------------------------------------------
# "local" écrit dans ./uploads. Voir DECISIONS.md pour brancher R2/Supabase.
STOCKAGE="local"

# --- Tâches planifiées -------------------------------------------------------
# Secret pour appeler /api/cron/* (relances à froid). Vide = route désactivée.
CRON_SECRET=""
